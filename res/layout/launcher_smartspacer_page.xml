<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingTop="@dimen/first_page_status_top_padding">

    <TextClock
        android:id="@+id/launcher_smartspacer_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@*android:string/config_bodyFontFamilyMedium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:shadowColor="?attr/workspaceKeyShadowColor"
        android:shadowDx="0"
        android:shadowDy="0.5"
        android:shadowRadius="1"
        android:textColor="?attr/workspaceTextColor"
        android:textSize="@dimen/first_page_status_primary_text_size"
        android:visibility="gone" />

    <TextView
        android:id="@+id/launcher_smartspacer_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@*android:string/config_bodyFontFamilyMedium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:shadowColor="?attr/workspaceKeyShadowColor"
        android:shadowDx="0"
        android:shadowDy="0.5"
        android:shadowRadius="1"
        android:textColor="?attr/workspaceTextColor"
        android:textSize="@dimen/first_page_status_primary_text_size" />

    <LinearLayout
        android:id="@+id/launcher_smartspacer_subtitle_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/first_page_status_line_spacing"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/launcher_smartspacer_subtitle_icon"
            android:layout_width="@dimen/first_page_status_icon_size"
            android:layout_height="@dimen/first_page_status_icon_size"
            android:layout_marginEnd="@dimen/first_page_status_icon_spacing"
            android:visibility="gone" />

        <TextView
            android:id="@+id/launcher_smartspacer_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@*android:string/config_bodyFontFamily"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="?attr/workspaceKeyShadowColor"
            android:shadowDx="0"
            android:shadowDy="0.5"
            android:shadowRadius="1"
            android:textColor="?attr/workspaceTextColor"
            android:textSize="@dimen/first_page_status_secondary_text_size" />

        <ImageView
            android:id="@+id/launcher_smartspacer_supplemental_icon"
            android:layout_width="@dimen/first_page_status_icon_size"
            android:layout_height="@dimen/first_page_status_icon_size"
            android:layout_marginStart="@dimen/first_page_status_item_spacing"
            android:layout_marginEnd="@dimen/first_page_status_icon_spacing"
            android:visibility="gone" />

        <TextView
            android:id="@+id/launcher_smartspacer_supplemental"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@*android:string/config_bodyFontFamily"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="?attr/workspaceKeyShadowColor"
            android:shadowDx="0"
            android:shadowDy="0.5"
            android:shadowRadius="1"
            android:textColor="?attr/workspaceTextColor"
            android:textSize="@dimen/first_page_status_secondary_text_size"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
