<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/derp_card_side_margin"
    android:layout_marginTop="@dimen/derp_vertical_padding"
    android:layout_marginBottom="@dimen/derp_vertical_padding"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="@dimen/derp_card_radius"
    app:cardElevation="0dp"
    app:cardPreventCornerOverlap="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/settings_header_background"
        android:clipToOutline="true"
        android:outlineProvider="background">

        <ImageView
            android:id="@+id/settings_header_wallpaper"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="@id/settings_header_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/settings_header_content" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/settings_header_wallpaper_scrim"
            app:layout_constraintBottom_toBottomOf="@id/settings_header_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/settings_header_content" />

        <LinearLayout
            android:id="@+id/settings_header_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="@dimen/derp_branding_half_height"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/derp_branding_image"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:paddingStart="70dp"
                android:paddingEnd="70dp"
                android:scaleType="fitCenter"
                android:src="@drawable/derp_branding_image"
                android:tint="?android:attr/colorAccent" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
